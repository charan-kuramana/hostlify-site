# Copy to .env (local) or set in your hosting provider's environment settings.
# VITE_* values are bundled into the browser — never put secrets here.

# Product app (log in / sign up / discover links). Login links are hidden while site.features.login = false.
VITE_APP_URL=https://app.hostlify.in
# Canonical site URL used in meta tags, Open Graph and sitemap.xml
VITE_SITE_URL=https://hostlify.in

# Lead forms — set ONE of these, otherwise forms fall back to opening a pre-filled email.
# Your own API endpoint (JSON POST), e.g. hostlify-api /public/leads
VITE_LEAD_ENDPOINT=
# Web3Forms access key (free, https://web3forms.com) — emails leads to the inbox the key was created with
VITE_WEB3FORMS_KEY=

# Cal.com link for the /demo scheduler, e.g. hostlify/demo (scheduler hidden when empty)
VITE_CAL_LINK=
# Sales WhatsApp (country code + number, no +). Defaults to the number in src/lib/env.ts
VITE_WHATSAPP_NUMBER=919908176754
